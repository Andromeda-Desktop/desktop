set positional-arguments

set allow-duplicate-recipes
import '../tools/module.just'


default:
    @just --list

configure m=mode install_prefix=prefix:
    #!/usr/bin/env bash
    set -euo pipefail
    args=(--buildtype={{ if m == "release" { "release" } else { "debug" } }} -Dcpp_std={{cpp-std}} -Dtests=auto --prefix "{{install_prefix}}")
    [[ "{{m}}" == "release" ]] && args+=(-Db_lto=true)
    [[ "{{m}}" == "asan"    ]] && args+=(-Db_sanitize=address,undefined)
    just _meson-setup "{{m}}" plain "${args[@]}"

build m=mode: (_ensure-configured m)
    # Named targets fail on a dir configured before they existed; regenerate first (no-op when current).
    ../tools/build.sh ninja -C build-{{m}} build.ninja
    ../tools/build.sh meson compile -C build-{{m}} andromeda-shell:executable andromeda-shell:shared_module noctalia-calc

_ensure-configured m=mode:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f "build-{{m}}/build.ninja" ]]; then
        just configure {{m}}
        exit 0
    fi
    configure_output="$(meson configure "build-{{m}}")"
    current_cpp_std="$(awk '$1 == "cpp_std" { print $2; found=1 } END { if (!found) exit 1 }' <<<"$configure_output")"
    current_tests="$(awk '$1 == "tests" { print $2; found=1 } END { if (!found) exit 1 }' <<<"$configure_output")"
    args=()
    [[ "$current_cpp_std" != "{{cpp-std}}" ]] && args+=(-Dcpp_std={{cpp-std}})
    [[ "$current_tests" != "auto" ]] && args+=(-Dtests=auto)
    if (( ${#args[@]} > 0 )); then
        ../tools/build.sh meson configure "build-{{m}}" "${args[@]}"
    fi

run m=mode: (build m)
    ./build-{{m}}/andromeda-shell

# Build and run the unit tests, enabling their targets when auto mode omits them.
test m=mode *args: (_ensure-configured m)
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "{{m}}" == "release" || "{{m}}" == "asan" ]]; then
        ../tools/build.sh meson setup "build-{{m}}" -Dtests=enabled --reconfigure >/dev/null
    fi
    ../tools/build.sh meson test -C build-{{m}} {{args}}

# Regressions for the GitHub workflow scripts. Pure Python, builds nothing.
test-workflows:
    python3 -m unittest discover -s .github/workflows/scripts -p 'test_*.py'

install m:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -x "build-{{m}}/andromeda-shell" ]]; then
        echo "error: build-{{m}}/andromeda-shell is missing; run 'just build {{m}}' before installing" >&2
        exit 1
    fi
    meson install --no-rebuild -C build-{{m}}

uninstall m:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f "build-{{m}}/build.ninja" ]]; then
        echo "error: build-{{m}} is missing or was not configured with the Ninja backend; nothing to uninstall" >&2
        exit 1
    fi
    ninja -C build-{{m}} uninstall

_check_formatter:
    #!/usr/bin/env bash
    set -euo pipefail
    version="$(clang-format --version)"
    echo "$version"
    if [[ ! "$version" =~ version\ ([0-9]+)\. ]] || [[ "${BASH_REMATCH[1]}" -lt 22 ]]; then
        echo "error: formatting requires clang-format 22 or newer; put its bin directory on PATH" >&2
        exit 1
    fi

format: format-code format-docs

format-check: format-code-check format-docs-check

format-code: _check_formatter
    find src tests \( -name '*.cpp' -o -name '*.h' \) -print0 | xargs -0 clang-format -i
    find src tests \( -name '*.cpp' -o -name '*.h' \) -print0 | xargs -0 grep -ZlP '\s+$' | xargs -0 -r sed -i 's/[[:space:]]*$//'

format-code-check: _check_formatter
    find src tests \( -name '*.cpp' -o -name '*.h' \) -print0 | xargs -0 clang-format --dry-run -Werror

_docs_formatter:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! ../tools/remark/node_modules/.package-lock.json -nt ../tools/remark/package-lock.json ]]; then
        npm ci --prefix ../tools/remark --no-audit --no-fund --loglevel=error
    fi

format-docs: _docs_formatter
    git ls-files -z '*.md' '*.mdx' ':!third_party' | xargs -0 -r node ../tools/remark/format.mjs

format-docs-check: _docs_formatter
    git ls-files -z '*.md' '*.mdx' ':!third_party' | xargs -0 -r node ../tools/remark/format.mjs --check

_clang_tidy m=mode *args:
    #!/usr/bin/env bash
    set -euo pipefail
    ../tools/build.sh meson compile -C "build-{{m}}" generated-headers
    src_root="$(realpath src)"
    # compile_commands.json stores build-relative paths, so clang-tidy emits header
    # diagnostics as ../src/...; the header-filter must match that form (an absolute
    # ^${src_root} anchor never matches, silently dropping every header diagnostic).
    # ../src/ also excludes vendored third_party/*/src/* headers.
    run-clang-tidy -quiet -use-color -p "build-{{m}}" -j "$(nproc)" -header-filter='\.\./src/.*' {{args}} "^${src_root}/.*"

lint m=mode: (_ensure-configured m)
    just _clang_tidy {{m}} '-warnings-as-errors=*'

fix m=mode: (_ensure-configured m)
    just _clang_tidy {{m}} -fix
    just format-code

role-alpha-check:
    python3 tools/role-alpha-check.py

role-alpha-update:
    python3 tools/role-alpha-check.py --update
