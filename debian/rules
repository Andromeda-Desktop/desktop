#!/usr/bin/make -f
# Ubuntu packages. Build and install steps live in pkg/deb-build.sh, which reuses the PKGBUILD's package_*() functions.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with installsysusers

override_dh_auto_configure override_dh_auto_test:

override_dh_auto_build:
	pkg/deb-build.sh build

override_dh_auto_install:
	pkg/deb-build.sh install

# The update helper runs the apt commit that configures this package: a restart of it, or a start of recover while
# the journal exists, waits on the commit that waits on the postinst. The helper is D-Bus activated and idles out.
# An app release (ANDROMEDA_APP) leaves andromeda-system empty: dh_installsystemd fails on a named unit it lacks.
override_dh_installsystemd:
	dh_installsystemd -Nandromeda-system
	if [ -e debian/andromeda-system/usr/lib/systemd/system/andromeda-system.service ]; then \
	  dh_installsystemd -pandromeda-system andromeda-system.service andromeda-update-tonight.timer && \
	  dh_installsystemd -pandromeda-system --no-start --no-stop-on-upgrade andromeda-update-helper.service andromeda-update-recover.service andromeda-update-tonight.service; \
	fi

# libandromeda-desk.so and the app modules sit in the private dir /usr/lib/andromeda.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/andromeda-libdesk/usr/lib/andromeda:$(CURDIR)/debian/andromeda-files/usr/lib/andromeda:$(CURDIR)/debian/andromeda-terminal/usr/lib/andromeda
	debian/lazy-depends.sh
