#!/usr/bin/make -f
# Ubuntu packages. Build and install steps live in pkg/deb-build.sh, which reuses the PKGBUILD's package_*() functions.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with installsysusers

override_dh_auto_configure override_dh_auto_test:

override_dh_auto_build:
	pkg/deb-build.sh build

override_dh_auto_install:
	pkg/deb-build.sh install

# libandromeda-desk.so and the app modules sit in the private dir /usr/lib/andromeda.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/andromeda-libdesk/usr/lib/andromeda:$(CURDIR)/debian/andromeda-files/usr/lib/andromeda:$(CURDIR)/debian/andromeda-terminal/usr/lib/andromeda
