[wrap-git]
url = https://gitlab.freedesktop.org/wlroots/wlroots.git
revision = 0.20.2
depth = 1
# Skips the cursor plane in an atomic commit when the cursor did not change (upstream re-arms it each frame).
# Skips layer feedback for planes another CRTC still holds at startup (no liftoff handle; upstream reads NULL).
# Registers the planes a previous master left on a CRTC at its first commit, not only on a modeset (no modeset at login).
# Resets IN_FENCE_FD to -1 on frames without a fence (the last fd is closed; every allocation failed with EINVAL, no plane).
# Fails a test that leaves a layer or the primary buffer without a plane. libliftoff links into the private libwlroots,
# so the compositor's liftoff_* interposer (src/server/liftoff_deadline.cpp) never runs in the package.
# Logs no error when closing an input device the kernel removed: logind already released it ("Device not taken").
# Keeps a previous master's MODE_ID blob unowned until a modeset replaces it (destroying it failed with EPERM).
# Sends a new MODE_ID in a commit without ALLOW_MODESET (upstream dropped the mode), so the kernel can fastset a
# refresh-only change or reject it; legacy KMS rejects such a commit.
# Sends surface dma-buf feedback only when it changes: Mesa reallocates every window buffer on each feedback, and
# the scene sent a copy of the default at each new window's first output commit.
# Records capture copies (screencopy, ext-image-copy, window capture) under deferred submits and reports them from a
# renderer kick, so the main loop never waits for the GPU (wlr_renderer_kick, wlr_texture_readback).
# Adds the libinput devices one per event loop turn from a path context and our own udev scan and monitor (keyboards
# and switches first), with a settled signal; libinput_udev_assign_seat() set up every device in one ~430 ms call.
# Logs the size, stride, format, modifier and fd size of a dma-buf whose plane 0 is out of bounds (the error named no values).
# Keeps an eDP output on a bad link status (no destroy, no forced modeset), as mutter does: the second training
# failed and once hung an HP Victus after s2idle.
diff_files = wlroots-cursor-plane-unchanged.patch, wlroots-feedback-unregistered-plane.patch, wlroots-register-planes-without-modeset.patch, wlroots-libliftoff-clear-in-fence.patch, wlroots-libliftoff-test-unshown-layer.patch, wlroots-session-close-removed-device.patch, wlroots-keep-previous-master-mode-blob.patch, wlroots-mode-change-without-modeset.patch, wlroots-dmabuf-feedback-unchanged.patch, wlroots-merge-queued-commits.patch, wlroots-nonblocking-modeset.patch, wlroots-deferred-capture.patch, wlroots-libinput-staged-start.patch, wlroots-dmabuf-reject-details.patch, wlroots-edp-bad-link-keep-output.patch

[provide]
dependency_names = wlroots-0.20
