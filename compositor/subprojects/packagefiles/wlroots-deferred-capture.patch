diff --git a/include/types/capture_copy.h b/include/types/capture_copy.h
new file mode 100644
index 0000000..f30455f
--- /dev/null
+++ b/include/types/capture_copy.h
@@ -0,0 +1,46 @@
+#ifndef TYPES_CAPTURE_COPY_H
+#define TYPES_CAPTURE_COPY_H
+
+#include <stdbool.h>
+#include <wlr/util/box.h>
+
+struct wlr_buffer;
+struct wlr_renderer;
+struct wlr_texture;
+struct wlr_texture_readback;
+
+enum capture_copy_state {
+	CAPTURE_COPY_IDLE,
+	// Waits until the renderer accepts new work.
+	CAPTURE_COPY_WAITING_RENDERER,
+	// The recorded copy runs on the GPU.
+	CAPTURE_COPY_IN_FLIGHT,
+};
+
+// Records a capture copy of src into dst only when the renderer accepts new
+// work, and reports it once the GPU ran it, so the caller never waits for the
+// GPU. dmabuf copies run record_dmabuf; shm copies read src_box of src.
+struct capture_copy {
+	enum capture_copy_state state;
+	struct wlr_renderer *renderer;
+	struct wlr_buffer *src; // locked while not idle
+	struct wlr_buffer *dst; // held by the owner
+	struct wlr_box src_box;
+	bool shm;
+	struct wlr_texture *texture; // shm without renderer readback: read when done
+	struct wlr_texture_readback *readback;
+	bool (*record_dmabuf)(void *data, struct wlr_buffer *src);
+	void (*done)(void *data, bool ok);
+	void *data;
+};
+
+// done runs once, possibly inside this call; the copy is idle again then.
+void capture_copy_start(struct capture_copy *copy, struct wlr_renderer *renderer,
+	struct wlr_buffer *src, struct wlr_buffer *dst, const struct wlr_box *src_box, bool shm,
+	bool (*record_dmabuf)(void *data, struct wlr_buffer *src),
+	void (*done)(void *data, bool ok), void *data);
+
+// Drops a copy in progress without calling done. No-op when idle.
+void capture_copy_cancel(struct capture_copy *copy);
+
+#endif
diff --git a/types/capture_copy.c b/types/capture_copy.c
new file mode 100644
index 0000000..34b5bb9
--- /dev/null
+++ b/types/capture_copy.c
@@ -0,0 +1,121 @@
+#include <assert.h>
+#include <wlr/render/wlr_renderer.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_buffer.h>
+#include "types/capture_copy.h"
+
+static void handle_renderer_ready(void *data, bool ok);
+static void handle_copied(void *data, bool ok);
+
+static void reset(struct capture_copy *copy) {
+	wlr_texture_readback_destroy(copy->readback);
+	if (copy->texture != NULL) {
+		wlr_texture_destroy(copy->texture);
+	}
+	wlr_buffer_unlock(copy->src);
+	*copy = (struct capture_copy){0};
+}
+
+static void finish(struct capture_copy *copy, bool ok) {
+	void (*done)(void *data, bool ok) = copy->done;
+	void *data = copy->data;
+	reset(copy);
+	done(data, ok);
+}
+
+static bool record_shm(struct capture_copy *copy) {
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(copy->dst,
+			WLR_BUFFER_DATA_PTR_ACCESS_WRITE, &data, &format, &stride)) {
+		return false;
+	}
+	wlr_buffer_end_data_ptr_access(copy->dst);
+	copy->texture = wlr_texture_from_buffer(copy->renderer, copy->src);
+	if (copy->texture == NULL) {
+		return false;
+	}
+	copy->readback = wlr_texture_readback_begin(copy->texture, &copy->src_box, format);
+	if (copy->readback != NULL) {
+		wlr_texture_destroy(copy->texture);
+		copy->texture = NULL;
+	}
+	return true;
+}
+
+static bool read_shm(struct capture_copy *copy) {
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(copy->dst,
+			WLR_BUFFER_DATA_PTR_ACCESS_WRITE, &data, &format, &stride)) {
+		return false;
+	}
+	const struct wlr_texture_read_pixels_options options = {
+		.data = data,
+		.format = format,
+		.stride = stride,
+		.src_box = copy->src_box,
+	};
+	bool ok = copy->readback != NULL ?
+		wlr_texture_readback_finish(copy->readback, &options) :
+		wlr_texture_read_pixels(copy->texture, &options);
+	wlr_buffer_end_data_ptr_access(copy->dst);
+	return ok;
+}
+
+static void handle_renderer_ready(void *data, bool ok) {
+	struct capture_copy *copy = data;
+	assert(copy->state == CAPTURE_COPY_WAITING_RENDERER);
+	if (ok) {
+		wlr_renderer_defer_submits(copy->renderer, true);
+		ok = copy->shm ? record_shm(copy) : copy->record_dmabuf(copy->data, copy->src);
+		wlr_renderer_defer_submits(copy->renderer, false);
+	}
+	if (!ok) {
+		finish(copy, false);
+		return;
+	}
+	copy->state = CAPTURE_COPY_IN_FLIGHT;
+	wlr_renderer_kick(copy->renderer, handle_copied, copy);
+}
+
+static void handle_copied(void *data, bool ok) {
+	struct capture_copy *copy = data;
+	assert(copy->state == CAPTURE_COPY_IN_FLIGHT);
+	finish(copy, ok && (!copy->shm || read_shm(copy)));
+}
+
+void capture_copy_start(struct capture_copy *copy, struct wlr_renderer *renderer,
+		struct wlr_buffer *src, struct wlr_buffer *dst, const struct wlr_box *src_box, bool shm,
+		bool (*record_dmabuf)(void *data, struct wlr_buffer *src),
+		void (*done)(void *data, bool ok), void *data) {
+	assert(copy->state == CAPTURE_COPY_IDLE);
+	*copy = (struct capture_copy){
+		.state = CAPTURE_COPY_WAITING_RENDERER,
+		.renderer = renderer,
+		.src = wlr_buffer_lock(src),
+		.dst = dst,
+		.src_box = src_box != NULL ? *src_box : (struct wlr_box){0},
+		.shm = shm,
+		.record_dmabuf = record_dmabuf,
+		.done = done,
+		.data = data,
+	};
+	wlr_renderer_kick(renderer, handle_renderer_ready, copy);
+}
+
+void capture_copy_cancel(struct capture_copy *copy) {
+	switch (copy->state) {
+	case CAPTURE_COPY_IDLE:
+		return;
+	case CAPTURE_COPY_WAITING_RENDERER:
+		wlr_renderer_cancel_kick(copy->renderer, handle_renderer_ready, copy);
+		break;
+	case CAPTURE_COPY_IN_FLIGHT:
+		wlr_renderer_cancel_kick(copy->renderer, handle_copied, copy);
+		break;
+	}
+	reset(copy);
+}
