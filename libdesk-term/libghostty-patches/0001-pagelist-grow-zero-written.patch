@@ -4208,6 +4208,40 @@ pub fn setMaxLines(self: *PageList, max: ?usize) void {
 /// adhere to max_size and max_lines.
 ///
 /// This returns the newly allocated page node if there is one.
+/// Zero a resident page's memory for reuse, writing only bytes that can be
+/// non-zero: the row and metadata areas in full, and in each used row the
+/// cells up to its last non-zero cell. Rows past `used_rows` and their cells
+/// are zero, as grow's fast path requires. A full memset costs a whole page of stores per
+/// recycled page; a flood of short lines leaves most cells zero.
+fn zeroWritten(
+    memory: []align(std.heap.page_size_min) u8,
+    l: Page.Layout,
+    used_rows: usize,
+) void {
+    assert(memory.len == l.total_size);
+    @memset(memory[l.cells_start + l.cells_size ..], 0);
+    const cols: usize = l.capacity.cols;
+    const rows: [*]const Row = @ptrCast(@alignCast(memory.ptr + l.rows_start));
+    for (rows[0..used_rows]) |r| {
+        // A blank row has only zero cells (Page.verifyIntegrity checks it).
+        if (r.blank) continue;
+        // Scrolling swaps rows' cell blocks, so each row names its own.
+        const row: []u64 = @as([*]u64, @ptrCast(r.cells.ptr(memory)))[0..cols];
+        // Forward, so the page streams through memory in order.
+        var end: usize = 0;
+        var x: usize = 0;
+        while (x + 8 <= cols) : (x += 8) {
+            const chunk: @Vector(8, u64) = row[x..][0..8].*;
+            if (@reduce(.Or, chunk) != 0) end = x + 8;
+        }
+        while (x < cols) : (x += 1) {
+            if (row[x] != 0) end = x + 1;
+        }
+        @memset(row[0..end], 0);
+    }
+    @memset(memory[0..l.cells_start], 0);
+}
