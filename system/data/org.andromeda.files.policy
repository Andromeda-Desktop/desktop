<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Files: Get Info changes and administrator tabs on items the user does not own (andromeda-fileops-admin). -->
<policyconfig>
  <vendor>Andromeda</vendor>
  <action id="org.andromeda.files.admin">
    <description>Manage files as the administrator</description>
    <message>Authentication is required to change files that belong to other users</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/andromeda/andromeda-fileops-admin</annotate>
  </action>
</policyconfig>
