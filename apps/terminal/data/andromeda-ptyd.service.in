[Unit]
Description=Andromeda Terminal pty holder, keeps shells running when a terminal window process dies
Requires=andromeda-ptyd.socket
PartOf=graphical-session.target

[Service]
# Each shell runs in its own Terminal scope; stopping this unit at log-out closes the ptys and hangs them up.
Slice=app.slice
ExecStart=@libexecdir@/andromeda/andromeda-ptyd --scope app-andromeda-dev.andromeda.Terminal --relaunch systemd-run --user --collect --quiet --slice=app.slice @bindir@/andromeda-terminal
Restart=no
