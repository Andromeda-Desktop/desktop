[Desktop Entry]
Type=Application
Name=Terminal
Comment=Use the command line
Exec=andromeda-terminal
Icon=dev.andromeda.Terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;commandline;cmd;
StartupNotify=true
X-ExecArg=-e
X-TerminalArgExec=-e
X-TerminalArgDir=--working-directory=
