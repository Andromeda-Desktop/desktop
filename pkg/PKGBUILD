  install -Dm644 desktop/system/data/upower-50-andromeda.conf "$pkgdir/etc/UPower/UPower.conf.d/50-andromeda.conf"
  _pin_depends
}

package_andromeda() {
  pkgdesc='Andromeda desktop: the Andromeda compositor, Noctalia shell, portal, and Link phone continuity'
  # Everything the desktop offers works out of the box; the power policy changes kernel defaults, so it stays opt-in.
  depends=(andromeda-compositor-git andromeda-shell-git xdg-desktop-portal-andromeda-git
    andromeda-greeter-git andromeda-preview-git andromeda-files-git andromeda-player-git andromeda-viewer-git
    andromeda-terminal-git andromeda-link andromeda-link-app-git gnome-keyring scrcpy android-tools gst-plugin-va gst-libav libpulse pipewire-pulse sqlite
    poppler-glib libzip libvterm exiv2 taglib glycin sdbus-cpp mpv ffmpeg)
  optdepends=('andromeda-power-git: laptop power saving (PCIe ASPM, runtime PM, USB autosuspend); can upset some devices')
  backup=(etc/mpv/mpv.conf)
  install -Dm644 desktop/session/mpv/mpv.conf "$pkgdir/etc/mpv/mpv.conf"
  install -Dm755 desktop/session/audio-park/andromeda-audio-park "$pkgdir/usr/bin/andromeda-audio-park"
  install -Dm644 desktop/session/audio-park/andromeda-audio-park.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-audio-park.service"
  install -d "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants"
  ln -s ../andromeda-audio-park.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/andromeda-audio-park.service"
  meson install --no-rebuild -C build-indexer --destdir "$pkgdir"
  install -Dm644 desktop/session/applications/andromeda-mimeapps.list "$pkgdir/usr/share/applications/andromeda-mimeapps.list"
  for unit in andromeda-index.socket andromeda-index.service; do
    ln -s ../$unit "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/$unit"
  done
  _pin_depends
}

# The apps and the preview release on their own (app tags), so each package carries its own runtime libraries.
_app_libs=(cairo pango fontconfig freetype2 glib2 harfbuzz libglvnd libjxl librsvg libwebp libxkbcommon sdbus-cpp wayland)

package_andromeda-preview-git() {
  pkgdesc='Andromeda Quick Look: previews, thumbnailers and the sandboxed media helper used by Files and Viewer'
  depends=("${_app_libs[@]}" glycin gstreamer gst-plugin-va gst-libav libpulse poppler-glib libzip exiv2 taglib mpv
    ffmpeg)
  optdepends=('libreoffice-fresh: Quick Look for Office documents')
  # Quick Look serves org.gnome.NautilusPreviewer, the bus name sushi owns.
  conflicts=(sushi)
  meson install --no-rebuild -C build-preview --destdir "$pkgdir"
  _pin_depends
}

# The shared libdesk of the apps that load as modules (libandromeda-<app>.so) and andromeda-appd, which forks them.
# Every such app depends on the ABI it was built against: any libdesk header or token change is a new ABI, and pacman
# then holds the libdesk upgrade until each installed app is rebuilt.
# makepkg reads provides/depends at global scope, and its fakeroot pass sources this file before it sets $srcdir:
# hash the clone in $startdir/src (deb-build.sh links $srcdir/desktop first), else the checkout around pkg/.
_libdesk_abi=unknown
for _tree in "${srcdir:-/nonexistent}/desktop" "${startdir:-/nonexistent}/src/desktop" "${startdir:-/nonexistent}/.."; do
  [[ -d $_tree/libdesk-app ]] || continue
  _libdesk_abi=$(cd "$_tree" && { find libdesk-*/src -name '*.h' -print0 | sort -z | xargs -0 sha256sum;
    sha256sum protocol/design-tokens.toml; } | sha256sum | cut -c1-16)
  break
done
_check_libdesk_abi() { [[ $_libdesk_abi != unknown ]] || { echo "libdesk ABI unknown: no desktop tree beside the PKGBUILD" >&2; return 1; }; }
package_andromeda-libdesk-git() {
  _check_libdesk_abi || return 1
  pkgdesc='Andromeda libdesk: the shared app toolkit and the app zygote (andromeda-appd)'
  depends=("${_app_libs[@]}")
  provides=("andromeda-libdesk-abi=$_libdesk_abi")
  local dir
  for dir in build-files build-terminal; do [[ -f $dir/build.ninja ]] && break; done
  meson install --no-rebuild -C "$dir" --destdir "$pkgdir" --tags libdesk
  install -d "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants"
  ln -s ../andromeda-appd.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/andromeda-appd.service"
  _pin_depends
}

# --skip-subprojects: libdesk ships in andromeda-libdesk-git and the preview in andromeda-preview-git.
package_andromeda-files-git() {
  _check_libdesk_abi || return 1
  pkgdesc='Andromeda Files: file manager, file pickers and FileManager1'
  depends=("${_app_libs[@]}" "andromeda-libdesk-abi=$_libdesk_abi" andromeda-preview-git libvterm libcups xdg-utils)
  optdepends=('cups: printing (the Print portal)'
    'gocryptfs: Files vaults'
              'gvfs-mtp: Files phones over MTP'
              'gvfs-gphoto2: Files cameras over PTP'
              'exfatprogs: Files Erase Drive as ExFAT'
              'dosfstools: Files Erase Drive as FAT32'
              'ntfs-3g: Files Erase Drive as NTFS')
  meson install --no-rebuild -C build-files --destdir "$pkgdir" --skip-subprojects
  install -d "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants"
  ln -s ../andromeda-files-reconnect.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/andromeda-files-reconnect.service"
  _pin_depends
}

