package_andromeda-greeter-git() {
  pkgdesc='greetd login for Andromeda: the shell greeter mode, with the old Noctalia greeter as a one-release fallback'
  depends=(andromeda-greetd andromeda-shell-git andromeda-compositor-git wlroots0.20 libinput libxkbcommon cairo pango librsvg libxml2 glib2 fontconfig freetype2)
  optdepends=('gaze-bin: face login; needs the marker-host change until it is upstream (tools/gaze-patched.sh)')
  provides=(noctalia-greeter)
  conflicts=(noctalia-greeter noctalia-greeter-desktop-git)
  replaces=(noctalia-greeter-desktop-git)
  install=noctalia-greeter.install
  meson install --no-rebuild -C build-greeter --destdir "$pkgdir"
  # Old /usr/bin/noctalia-greeter* names: a booted system with an old greetd config still logs in.
  for name in greeter greeter-apply-appearance greeter-session greeter-xsession greeter-print-greetd-config; do
    ln -s "andromeda-$name" "$pkgdir/usr/bin/noctalia-$name"
  done
  install -Dm644 desktop/session/pam.d/gdm-face "$pkgdir/etc/pam.d/gdm-face"
  # greetd runs the shell's greeter mode; the old greeter config stays one release as the fallback
  # (sudo tools/greeter-switch.sh legacy).
  install -Dm644 desktop/session/greetd/config-greeter-mode.toml "$pkgdir/usr/share/noctalia-greeter/greetd.toml"
  install -Dm644 desktop/session/greetd/config.toml "$pkgdir/usr/share/noctalia-greeter/greetd-legacy.toml"
  install -Dm644 desktop/session/greetd/noctalia-greeter.conf \
    "$pkgdir/usr/lib/systemd/system/greetd.service.d/noctalia-greeter.conf"
  install -Dm644 desktop/session/greetd/andromeda-login-fallback.service \
    "$pkgdir/usr/lib/systemd/system/andromeda-login-fallback.service"
  install -Dm644 desktop/greeter/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktop/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 desktop/greeter/assets/fonts/outfit-license.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Outfit.txt"
  _pin_depends
}
