pkgbase=desktop-git
pkgname=(andromeda andromeda-compositor-git andromeda-shell-git xdg-desktop-portal-andromeda-git
  andromeda-power-git andromeda-greeter-git andromeda-system-git andromeda-greetd andromeda-preview-git
  andromeda-files-git andromeda-player-git andromeda-viewer-git andromeda-terminal-git andromeda-link-app-git
  andromeda-libdesk-git)
# ANDROMEDA_APP=files|player|viewer|terminal|link-app (app release CI) builds only that app and, for Files and Viewer,
# the preview; for apps on the shared libdesk, libdesk.
if [[ -n ${ANDROMEDA_APP:-} ]]; then
  pkgname=(andromeda-$ANDROMEDA_APP-git)
  [[ ! $ANDROMEDA_APP =~ ^(files|viewer)$ ]] || pkgname+=(andromeda-preview-git)
  [[ ! $ANDROMEDA_APP =~ ^(files|terminal)$ ]] || pkgname+=(andromeda-libdesk-git)
fi
# ANDROMEDA_CORE=1 (core release CI): no app packages; the apps release on their own tags (release-apps).
if [[ -n ${ANDROMEDA_CORE:-} ]]; then
  for _app in files player viewer terminal link-app libdesk; do pkgname=(${pkgname[@]/andromeda-$_app-git}); done
fi
# ANDROMEDA_ONLY="compositor shell" (a unit release, or a test install of changed parts): builds and packages only
# those units.
if [[ -n ${ANDROMEDA_ONLY:-} ]]; then
  declare -A _unit_pkg=([compositor]=andromeda-compositor-git [shell]=andromeda-shell-git
    [portal]=xdg-desktop-portal-andromeda-git [greeter]=andromeda-greeter-git [preview]=andromeda-preview-git
    [system]=andromeda-system-git [greetd]=andromeda-greetd [power]=andromeda-power-git)
  pkgname=()
  for _part in $ANDROMEDA_ONLY; do pkgname+=("${_unit_pkg[$_part]:?unknown unit $_part}"); done
fi
_apps=(files viewer player terminal link-app)
[[ -z ${ANDROMEDA_CORE:-} ]] || _apps=()
# Epoch keeps the monorepo revision newer than the per-fork versions it replaces.
epoch=1
pkgver=2026.11.7.r16760
pkgrel=1
arch=(x86_64)
license=(GPL-3.0-or-later MIT)
# Arch's default makepkg.conf adds a debug package of every binary's symbols, several times the desktop's size.
options=(!debug)
makedepends=(git meson ninja wayland-protocols xorg-xwayland poppler-glib libzip libvterm libcups exiv2 taglib nlohmann-json stb
  wlroots0.20 wayland libinput libei libxkbcommon libdrm pixman mesa cairo pango lcms2 jemalloc tomlplusplus
  curl fontconfig freetype2 glib2 harfbuzz libglvnd libical libjxl libpipewire libqalculate librsvg
  libsndfile libsodium libwebp libwireplumber libxml2 md4c pam polkit qrencode sdbus-cpp xdg-desktop-portal gtk4 cargo protobuf
  gstreamer gst-plugins-base-libs qt6-base qt6-declarative qt6-multimedia sqlite mpv ffmpeg zig)
url=https://github.com/Andromeda-Desktop/desktop
# `just package` and the release workflow build a local checkout; anyone else builds the published repository.
# greetd base for andromeda-greetd; our patches are in desktop/session/greetd/patches.
source=("desktop::git+${ANDROMEDA_SOURCE:-$url.git}"
  "greetd::git+https://github.com/kennylevinsen/greetd#commit=d5f27c3a8b1758da9e45608d2cff20303f21c2ff")
sha256sums=(SKIP SKIP)

# The unit's computed version (ANDROMEDA_VERSION from a release tag, else its last tag plus the commit count).
pkgver() {
  desktop/tools/unit-version.sh "${ANDROMEDA_APP:-core}"
}

prepare() {
  # libghostty-vt has no Arch package: the terminal links the pinned build statically.
  [[ -n ${ANDROMEDA_APP:-} && $ANDROMEDA_APP != terminal ]] || desktop/tools/build-libghostty.sh
  if [[ -n ${ANDROMEDA_APP:-} ]]; then
    [[ ! $ANDROMEDA_APP =~ ^(files|viewer)$ ]] || cargo fetch --locked --manifest-path desktop/andromeda-preview/helper/Cargo.toml
    return
  fi
  cargo fetch --locked --manifest-path desktop/system/Cargo.toml
  cargo fetch --locked --manifest-path desktop/andromeda-preview/helper/Cargo.toml
  # An incremental build reuses src/greetd: makepkg's checkout resets tracked files, clean drops files a patch added.
  git -C greetd clean -fdq -e target
  local patch
  for patch in desktop/session/greetd/patches/*.patch; do
    patch -d greetd -Np1 < "$patch"
  done
  cargo fetch --locked --manifest-path greetd/Cargo.toml
}

build() {
  # The host makepkg.conf (CachyOS) sets -march=native and -O3; packages must run on any x86-64 CPU and match the
  # release builds (Arch makepkg.conf: -O2; -O3 adds 11 % shell code and no measured speed).
  CFLAGS="${CFLAGS//-march=native/-march=x86-64 -mtune=generic}" CXXFLAGS="${CXXFLAGS//-march=native/-march=x86-64 -mtune=generic}"
  CFLAGS="${CFLAGS//-O3/-O2}" CXXFLAGS="${CXXFLAGS//-O3/-O2}"
  RUSTFLAGS="${RUSTFLAGS//-C target-cpu=native/}"
  # Incremental: build dirs stay in srcdir between runs. default_options apply only on the first configure, so a
  # change to any meson file or wrap starts the build dirs over.
  local stamp
  stamp=$(git -C desktop ls-files -s -- ':(glob)**/meson.build' ':(glob)**/meson.options' ':(glob)**/meson_options.txt' \
    ':(glob)**/*.wrap' ':(glob)**/packagefiles/**' | sha256sum)
  # Meson applies a wrap's diff_files only on download: drop the patched checkouts too, so new patches apply.
  [[ ! -f meson.stamp || $(<meson.stamp) == "$stamp" ]] || rm -rf build-* desktop/compositor/subprojects/{wlroots,libliftoff}
  arch-meson() { if [[ -f $2/build.ninja ]]; then command arch-meson "$@" --reconfigure; else command arch-meson "$@"; fi; }
  if [[ -n ${ANDROMEDA_APP:-} ]]; then
    if [[ $ANDROMEDA_APP =~ ^(files|viewer)$ ]]; then
      arch-meson desktop/andromeda-preview build-preview -Dcpp_std=c++23 -Db_lto=true -Dlibdesk-ui:dev_tokens=false
      meson compile -C build-preview
    fi
    arch-meson "desktop/apps/$ANDROMEDA_APP" "build-$ANDROMEDA_APP" -Dcpp_std=c++23 -Db_lto=true -Dlibdesk-ui:dev_tokens=false
    meson compile -C "build-$ANDROMEDA_APP"
    return
  fi
  # The wlroots and libliftoff wraps carry our patches (compositor/subprojects/packagefiles). libliftoff is shared so
  # libwlroots' calls reach the andromeda executable's overrides (src/server/liftoff_deadline.cpp).
  # --wrap-mode overrides arch-meson's nodownload.
  _want() { [[ -z ${ANDROMEDA_ONLY:-} || " $ANDROMEDA_ONLY " == *" $1 "* ]]; }
  _want compositor && arch-meson desktop/compositor build-compositor -Dcpp_std=c++23 -Dtests=disabled -Db_lto=true \
    --wrap-mode=default --force-fallback-for=wlroots-0.20,libliftoff \
    -Dwlroots:libliftoff=enabled -Dlibliftoff:default_library=shared -Dlibliftoff:werror=false -Dwlroots:renderers=gles2
  _want shell && arch-meson desktop/shell build-shell -Dcpp_std=c++23 -Dtests=disabled -Db_lto=true -Dlibdesk-ui:dev_tokens=false
  _want portal && arch-meson desktop/portal build-portal -Dcpp_std=c++23
  _want greeter && arch-meson desktop/greeter build-greeter -Dcpp_std=c++23 -Db_lto=true -Dlibdesk-ui:dev_tokens=false
  _want preview && arch-meson desktop/andromeda-preview build-preview -Dcpp_std=c++23 -Db_lto=true -Dlibdesk-ui:dev_tokens=false
  # The indexer ships in the meta package, which only a full release builds.
  [[ -n ${ANDROMEDA_ONLY:-} ]] || arch-meson desktop/indexer build-indexer -Db_lto=true
  for app in "${_apps[@]}"; do
    arch-meson desktop/apps/$app build-$app -Dcpp_std=c++23 -Db_lto=true -Dlibdesk-ui:dev_tokens=false
  done
  for part in compositor shell portal greeter preview; do _want $part && meson compile -C build-$part; done
  [[ -n ${ANDROMEDA_ONLY:-} ]] || meson compile -C build-indexer
  for app in "${_apps[@]}"; do meson compile -C build-$app; done
  [[ -n ${ANDROMEDA_ONLY:-} ]] || echo "$stamp" > meson.stamp
  _want system && CFLAGS="${CFLAGS//-flto=auto/}" CXXFLAGS="${CXXFLAGS//-flto=auto/}" cargo build --frozen --release --manifest-path desktop/system/Cargo.toml
  _want greetd && cargo build --frozen --release --manifest-path greetd/Cargo.toml -p greetd
  return 0
}

# Library dependencies at least at the version this was built against: an Andromeda-only update (Settings) on an
# older system then needs those system packages, and the update helper refuses it instead of a partial upgrade.
_pin_depends() {
  local dep name version pinned=()
  for dep in "${depends[@]}"; do
    if [[ $dep == *[\<\>=]* || $dep == andromeda* || $dep == noctalia* || $dep == xdg-desktop-portal-andromeda* ]]; then
      pinned+=("$dep")
      continue
    fi
    # Only a package of that exact name: a provider (bash for sh) may not carry a version.
    read -r name version < <(pacman -Q "$dep" 2> /dev/null) || true
    [[ $name == "$dep" ]] || version=
    # pkgver without pkgrel: a mirror one rebuild behind the build container still satisfies it.
    version=${version%-*}
    # No epoch: CachyOS repackages with a higher epoch (mesa 3:x) than Arch (1:x) for the same upstream version.
    version=${version#*:}
    # No git snapshot (glibc 2.44+r78+g…): CachyOS builds the same upstream release from an older snapshot (+r50).
    version=${version%%+r*}
    pinned+=("$dep${version:+>=$version}")
  done
  # The soname of each linked system library (libjxl.so=0.12-64): pacman then holds an ABI-breaking library
  # upgrade until a rebuilt Andromeda is available, instead of leaving binaries with a missing library.
  local so soname
  while read -r so; do
    soname="${so%%.so.*}.so=${so#*.so.}-64"
    [[ $so == *.so.* && -z $(pacman -T "$soname") ]] && pinned+=("$soname")
  done < <(find "$pkgdir" -type f -print0 | xargs -0r readelf -d 2> /dev/null |
    sed -nr 's/.*Shared library: \[(.*)\].*/\1/p' | sort -u)
  depends=("${pinned[@]}")
}

package_andromeda-greetd() {
  pkgdesc='greetd with a GDM-style hand-off: the greeter stays on screen until the session took its own VT'
  depends=(pam)
  provides=(greetd=0.10.3)
  conflicts=(greetd)
  backup=(etc/greetd/config.toml etc/pam.d/greetd)
  install -Dm755 greetd/target/release/greetd "$pkgdir/usr/bin/greetd"
  install -Dm644 greetd/config.toml "$pkgdir/etc/greetd/config.toml"
  install -Dm644 desktop/session/greetd/greetd.pam "$pkgdir/etc/pam.d/greetd"
  install -Dm644 desktop/session/greetd/greetd.service "$pkgdir/usr/lib/systemd/system/greetd.service"
  install -Dm644 desktop/session/greetd/greetd.sysusers "$pkgdir/usr/lib/sysusers.d/greetd.conf"
  # The cache dir of the greeter user this package creates (shader cache for greeter mode).
  install -Dm644 desktop/session/greetd/andromeda-greeter.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/andromeda-greeter.conf"
  install -Dm644 greetd/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

