}

package_andromeda-terminal-git() {
  _check_libdesk_abi || return 1
  pkgdesc='Andromeda Terminal: terminal emulator on libghostty-vt'
  depends=("${_app_libs[@]}" "andromeda-libdesk-abi=$_libdesk_abi" ttf-fira-code) # the mono token font (design-tokens.toml font.mono)
  meson install --no-rebuild -C build-terminal --destdir "$pkgdir" --skip-subprojects
  install -Dm644 desktop/apps/terminal/subprojects/libghostty-vt/prefix/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/libghostty-vt-LICENSE"
  _pin_depends
}

package_andromeda-compositor-git() {
  pkgdesc='Andromeda Wayland compositor'
  install=andromeda-compositor.install
  depends=(libcap wlroots0.20 wayland libinput libei libxkbcommon libdrm pixman mesa cairo pango librsvg lcms2 jemalloc tomlplusplus
    xwayland-satellite)
  provides=(andromeda-compositor)
  conflicts=(andromeda-compositor umbriel umbriel-desktop-git)
  replaces=(umbriel-desktop-git)
  meson install --no-rebuild -C build-compositor --destdir "$pkgdir"
  # Only the wraps' libraries ship, in the compositor's private RPATH (compositor/meson.build).
  mkdir -p "$pkgdir/usr/lib/andromeda"
  mv "$pkgdir"/usr/lib/libwlroots-0.20.so* "$pkgdir"/usr/lib/libliftoff.so.* "$pkgdir/usr/lib/andromeda/"
  rm -r "$pkgdir/usr/include/wlroots-0.20" "$pkgdir/usr/lib/pkgconfig/wlroots-0.20.pc"
  rm "$pkgdir/usr/include/libliftoff.h" "$pkgdir/usr/lib/libliftoff.so" "$pkgdir/usr/lib/pkgconfig/libliftoff.pc"
  rmdir --ignore-fail-on-non-empty "$pkgdir/usr/include" "$pkgdir/usr/lib/pkgconfig"
  install -Dm644 desktop/session/at-spi-dbus-bus.service.d/andromeda-stop-registry.conf \
    "$pkgdir/usr/lib/systemd/user/at-spi-dbus-bus.service.d/andromeda-stop-registry.conf"
  for unit in 'app-blueman@autostart.service' 'app-nm\x2dapplet@autostart.service'; do
    install -Dm644 desktop/session/autostart/skip-in-andromeda.conf "$pkgdir/usr/lib/systemd/user/$unit.d/andromeda.conf"
  done
  install -Dm644 desktop/session/memory/user-session.slice.conf \
    "$pkgdir/usr/lib/systemd/user/session.slice.d/andromeda-ui-memory.conf"
  install -Dm644 desktop/session/memory/user-app.slice.conf \
    "$pkgdir/usr/lib/systemd/user/app.slice.d/andromeda-qos.conf"
  install -Dm644 desktop/session/memory/user-service.conf \
    "$pkgdir/usr/lib/systemd/system/user@.service.d/andromeda-ui-memory.conf"
  install -Dm644 desktop/session/memory/user-delegate.conf \
    "$pkgdir/usr/lib/systemd/system/user@.service.d/andromeda-delegate.conf"
  for slice in user.slice user-.slice; do
    install -Dm644 desktop/session/memory/user-system.slice.conf \
      "$pkgdir/usr/lib/systemd/system/$slice.d/andromeda-ui-memory.conf"
  done
  install -Dm644 desktop/compositor/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktop/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  _pin_depends
}

package_andromeda-shell-git() {
  pkgdesc='Noctalia desktop shell, desktop fork'
  depends=(bash cairo curl fontconfig freetype2 git glib2 glibc harfbuzz hicolor-icon-theme jemalloc libgcc libglvnd
    libical libjxl libpipewire libqalculate librsvg libsndfile libsodium openssl libstdc++ libwebp libwireplumber
    libxkbcommon libxml2 md4c pam polkit pango qrencode sdbus-cpp tomlplusplus wayland
    gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugin-pipewire gst-plugin-va andromeda-system-git)
  optdepends=('ddcutil: monitor brightness control' 'fprintd: fingerprint unlock and fingerprint for admin prompts')
  provides=(noctalia)
  conflicts=(noctalia noctalia-desktop-git)
  replaces=(noctalia-desktop-git)
  backup=(etc/pam.d/andromeda-lock)
  install=andromeda-shell.install
  meson install --no-rebuild -C build-shell --destdir "$pkgdir"
  install -Dm644 desktop/session/andromeda-askpass.sysusers "$pkgdir/usr/lib/sysusers.d/andromeda-askpass.conf"
  # Old /usr/bin/noctalia name for upgraded systems with old configs.
  ln -s andromeda-shell "$pkgdir/usr/bin/noctalia"
  install -Dm644 desktop/session/andromeda-shell.service "$pkgdir/usr/lib/systemd/user/andromeda-shell.service"
  ln -s andromeda-shell.service "$pkgdir/usr/lib/systemd/user/noctalia.service"
  install -Dm644 desktop/session/andromeda-lock.service "$pkgdir/usr/lib/systemd/user/andromeda-lock.service"
  # Shell greeter mode: greetd runs it through /usr/share/noctalia-greeter/greetd.toml (andromeda-greeter-git).
  install -Dm755 desktop/session/greetd/andromeda-greeter-session "$pkgdir/usr/lib/andromeda/andromeda-greeter-session"
  install -Dm644 desktop/session/pam.d/andromeda-greeter "$pkgdir/etc/pam.d/andromeda-greeter"
  install -Dm644 desktop/session/pam.d/andromeda-lock "$pkgdir/etc/pam.d/andromeda-lock"
  install -Dm755 desktop/session/power/andromeda-power-config "$pkgdir/usr/lib/andromeda/andromeda-power-config"
  # A copy, not a link: polkit picks the action by the program path, and the second path needs admin every time.
  install -Dm755 desktop/session/power/andromeda-power-config "$pkgdir/usr/lib/andromeda/andromeda-power-system"
  install -Dm644 desktop/session/power/org.andromeda.power.configure.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.andromeda.power.configure.policy"
  install -Dm755 desktop/session/power/andromeda-face-admin "$pkgdir/usr/lib/andromeda/andromeda-face-admin"
  install -Dm755 desktop/session/power/andromeda-finger-admin "$pkgdir/usr/lib/andromeda/andromeda-finger-admin"
  install -Dm644 desktop/session/power/org.andromeda.biometrics.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.andromeda.biometrics.policy"
  install -Dm644 desktop/shell/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktop/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  _pin_depends
}

